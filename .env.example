# Shared
NODE_ENV=development
BACKEND_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_MAPBOX_TOKEN=replace-me

# Backend
APP_NAME=East Dulwich Forum API
API_V1_STR=/api/v1
SECRET_KEY=replace-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=4320
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/ed_forum
REDIS_URL=redis://redis:6379/0
EMAIL_SENDER=no-reply@eastdulwichforum.local
RATE_LIMIT=60/minute
ALLOWED_ORIGINS=http://localhost:3000
