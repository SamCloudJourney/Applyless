      ],
      restaurant: [
        'Nando\'s', 'Pizza Express', 'Wagamama', 
        'TGI Fridays', 'Harvester', 'Prezzo'
      ]
    };
    
    // REALISTIC SALARY RANGES BY SECTOR
    const salaryRanges = {
      education: { min: 18000, max: 43000, format: 'yearly' },
      healthcare: { min: 22000, max: 55000, format: 'yearly' },
      cafe: { min: 11, max: 16, format: 'hourly' },
      tech: { min: 25000, max: 75000, format: 'yearly' },
      retail: { min: 10, max: 15, format: 'hourly' },
      warehouse: { min: 12, max: 18, format: 'hourly' },
      restaurant: { min: 10, max: 14, format: 'hourly' }
    };
    
    const companies = ukCompanies[sector] || ukCompanies['retail'];
    const salaryRange = salaryRanges[sector] || salaryRanges['retail'];
    
    // Generate 10 realistic jobs
    const jobs = Array.from({ length: 10 }, (_, i) => {
      const company = companies[i % companies.length];
      const baseMinSalary = salaryRange.min + (i * 2000);
      const baseMaxSalary = salaryRange.max + (i * 2000);
      
      let salaryText;
      if (salaryRange.format === 'hourly') {
        salaryText = `£${baseMinSalary} - £${baseMaxSalary} per hour`;
      } else {
        salaryText = `£${baseMinSalary} - £${baseMaxSalary} per year`;
      }
      
      return {
