    } else if (jobTitleLower.includes('developer') || jobTitleLower.includes('engineer') || 
               jobTitleLower.includes('tech') || jobTitleLower.includes('software')) {
      sector = 'tech';
    } else if (jobTitleLower.includes('shop') || jobTitleLower.includes('sales') || 
               jobTitleLower.includes('customer')) {
      sector = 'retail';
    }
    
    // REALISTIC UK COMPANIES BY SECTOR
    const ukCompanies = {
      education: [
        'Pearson Education', 'Cambridge Assessment', 'Oxford University Press',
        'Education First', 'Kaplan UK', 'Study Group'
      ],
      healthcare: [
        'NHS Digital', 'Bupa', 'Vitality Health', 
