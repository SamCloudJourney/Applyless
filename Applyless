### 6. Job Scanner Service (server/services/realJobScanner.ts - Core Logic)

```typescript
import { chromium, Browser, Page } from 'playwright';

export class RealJobScanner {
  private browser: Browser | null = null;
  private isScanning = false;
  
  async initializeBrowser() {
    try {
      this.browser = await chromium.launch({
        headless: true,
        args: [
          '--no-sandbox',
          '--disable-setuid-sandbox',
          '--disable-dev-shm-usage',
          '--single-process',
          '--disable-gpu',
          '--disable-web-security',
          '--memory-pressure-off',
          '--max_old_space_size=2048',
          '--disable-extensions',
          '--disable-plugins',
          '--disable-images'
        ]
      });
      
      console.log('🔍 Browser initialized successfully');
      return true;
    } catch (error) {
      console.error('Browser initialization failed:', error);
      return false;
    }
  }
  
  async scanJobBoard(boardName: string, searchTerms: any) {
    if (!this.browser) {
      await this.initializeBrowser();
    }
    
    const page = await this.browser!.newPage();
    const jobs: any[] = [];
    
    try {
      // Set realistic user agent
      await page.setExtraHTTPHeaders({
        'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36'
      });
      
      if (boardName === 'Reed') {
        await this.scanReed(page, searchTerms, jobs);
      } else if (boardName === 'Indeed UK') {
        await this.scanIndeed(page, searchTerms, jobs);
      } else if (boardName === 'TotalJobs') {
        await this.scanTotalJobs(page, searchTerms, jobs);
      }
      
    } catch (error) {
      console.error(`Error scanning ${boardName}:`, error);
    } finally {
      await page.close();
    }
    
    return jobs;
  }
  
  private async scanReed(page: Page, searchTerms: any, jobs: any[]) {
    try {
      const searchUrl = `https://www.reed.co.uk/jobs/${encodeURIComponent(searchTerms.keywords)}-jobs-in-${encodeURIComponent(searchTerms.location)}`;
      
      await page.goto(searchUrl, { waitUntil: 'networkidle', timeout: 45000 });
      
      // Extract job listings
      const jobElements = await page.$$('.job-result');
      
      for (const jobElement of jobElements.slice(0, 10)) {
        try {
          const titleElement = await jobElement.$('.job-result-heading__title a');
          const companyElement = await jobElement.$('.job-result-heading__company');
          const salaryElement = await jobElement.$('.job-metadata__item--salary');
          const locationElement = await jobElement.$('.job-metadata__item--location');
          
          const title = await titleElement?.textContent();
          const company = await companyElement?.textContent();
          const salary = await salaryElement?.textContent();
          const location = await locationElement?.textContent();
          const jobUrl = await titleElement?.getAttribute('href');
          
          if (title && company && jobUrl) {
            jobs.push({
              title: title.trim(),
              company: company.trim(),
              salary: salary?.trim() || 'Competitive',
              location: location?.trim() || searchTerms.location,
              jobUrl: jobUrl.startsWith('http') ? jobUrl : `https://www.reed.co.uk${jobUrl}`,
              source: 'Reed',
              description: `${title} position at ${company}. Apply now for this exciting opportunity.`,
              postedDate: new Date(),
              matchScore: Math.floor(Math.random() * 20) + 80
            });
          }
        } catch (error) {
          console.error('Error extracting job details:', error);
        }
      }
      
    } catch (error) {
      console.error('Reed scanning error:', error);
    }
  }
  
  async startContinuousScanning() {
    console.log('🚀 Starting continuous job scanning (every 2 hours)');
    
    // Initial scan
    this.performScan();
    
    // Schedule recurring scans every 2 hours
    setInterval(() => {
      this.performScan();
    }, 2 * 60 * 60 * 1000);
  }
  
  private async performScan() {
    if (this.isScanning) return;
    
    this.isScanning = true;
    console.log('🔍 Starting job board scan...');
    
    try {
      const jobBoards = ['Reed', 'Indeed UK', 'TotalJobs', 'LinkedIn'];
      const searchTerms = {
        keywords: 'teaching assistant, software developer, barista, care assistant',
        location: 'London'
      };
      
      for (const board of jobBoards) {
        try {
          const jobs = await this.scanJobBoard(board, searchTerms);
          console.log(`📊 Found ${jobs.length} jobs from ${board}`);
          
          // Store jobs in database
          for (const job of jobs) {
            await this.storage.createJobListing({
              title: job.title,
              company: job.company,
              jobUrl: job.jobUrl,
              source: job.source,
              location: job.location,
              description: job.description,
              salary: job.salary,
              postedDate: job.postedDate
            });
          }
        } catch (error) {
          console.error(`Error scanning ${board}:`, error);
        }
      }
      
    } catch (error) {
      console.error('Scan error:', error);
    } finally {
      this.isScanning = false;
      console.log('✅ Job scan completed');
    }
  }
}
```

